{
  "schemaVersion": 1,
  "id": "top-bar",
  "name": "TopBar",
  "title": "TopBar",
  "version": "1.0.1",
  "apiVersion": 1,
  "author": "Nelson",
  "license": "MIT",
  "entryClass": "me.jxl.kiosk.plugins.hello.TopBarPlugin",
  "main": "me.jxl.kiosk.plugins.hello.TopBarPlugin",
  "minAndroidSdk": 26,
  "description": "Floating control bar with auto-hide, day/night mode and Home Assistant actions.",
  "capabilities": ["host.read"],
  "settings": [
    {
      "id": "ha_url", "key": "ha_url", "name": "ha_url",
      "title": "HA URL", "label": "HA URL",
      "type": "string", "default": "http://192.168.1.225:8123"
    },
    {
      "id": "ha_token", "key": "ha_token", "name": "ha_token",
      "title": "HA Token", "label": "HA Token",
      "type": "string", "default": ""
    },
    {
      "id": "theme", "key": "theme", "name": "theme",
      "title": "Theme", "label": "Theme",
      "type": "select", "options": ["Auto (System)", "Dark", "Light"], "default": "Auto (System)"
    },
    {
      "id": "menu_position", "key": "menu_position", "name": "menu_position",
      "title": "Position", "label": "Position",
      "type": "select", "options": ["Center", "Left", "Right"], "default": "Right"
    },
    {
      "id": "scale", "key": "scale", "name": "scale",
      "title": "Size", "label": "Size",
      "type": "select", "options": ["80%", "100%", "120%"], "default": "100%"
    },
    {
      "id": "btn1_icon", "key": "btn1_icon", "name": "btn1_icon",
      "title": "Button 1 - Icon", "label": "Button 1 - Icon",
      "type": "string", "default": "mdi-home-import-outline"
    },
    {
      "id": "btn1_color", "key": "btn1_color", "name": "btn1_color",
      "title": "Button 1 - Color", "label": "Button 1 - Color",
      "type": "string", "default": "#4CAF50"
    },
    {
      "id": "btn1_target", "key": "btn1_target", "name": "btn1_target",
      "title": "Button 1 - Action", "label": "Button 1 - Action",
      "type": "string", "default": "script.ligar_casa_diogo"
    },
    {
      "id": "btn2_icon", "key": "btn2_icon", "name": "btn2_icon",
      "title": "Button 2 - Icon", "label": "Button 2 - Icon",
      "type": "string", "default": "mdi-home-export-outline"
    },
    {
      "id": "btn2_color", "key": "btn2_color", "name": "btn2_color",
      "title": "Button 2 - Color", "label": "Button 2 - Color",
      "type": "string", "default": "#F44336"
    },
    {
      "id": "btn2_target", "key": "btn2_target", "name": "btn2_target",
      "title": "Button 2 - Action", "label": "Button 2 - Action",
      "type": "string", "default": "script.desligar_tudo_teste"
    },
    {
      "id": "btn3_icon", "key": "btn3_icon", "name": "btn3_icon",
      "title": "Button 3 - Icon", "label": "Button 3 - Icon",
      "type": "string", "default": "mdi-spotify"
    },
    {
      "id": "btn3_color", "key": "btn3_color", "name": "btn3_color",
      "title": "Button 3 - Color", "label": "Button 3 - Color",
      "type": "string", "default": "#1DB954"
    },
    {
      "id": "btn3_target", "key": "btn3_target", "name": "btn3_target",
      "title": "Button 3 - Action", "label": "Button 3 - Action",
      "type": "string", "default": "script.abrir_spotify_no_tablet"
    }
  ],
  "commands": [
    {
      "id": "show", "key": "show", "name": "show",
      "title": "Show Bar", "label": "Show Bar"
    },
    {
      "id": "hide", "key": "hide", "name": "hide",
      "title": "Hide Bar", "label": "Hide Bar"
    }
  ]
}
