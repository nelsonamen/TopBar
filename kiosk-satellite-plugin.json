{
  "schemaVersion": 1,
  "id": "top-bar",
  "name": "TopBar",
  "title": "TopBar",
  "version": "1.0.2",
  "apiVersion": 1,
  "author": "Nelson",
  "license": "MIT",
  "entryClass": "me.jxl.kiosk.plugins.hello.TopBarPlugin",
  "main": "me.jxl.kiosk.plugins.hello.TopBarPlugin",
  "minAndroidSdk": 26,
  "description": "Floating control bar with auto-hide, day/night mode and Home Assistant actions.",
  "capabilities": ["host.read"],
  "settings": [
    {
      "id": "ha_url", "key": "ha_url", "name": "ha_url",
      "title": "HA URL", "label": "HA URL",
      "type": "string", "default": "http://192.168.1.225:8123"
    },
    {
      "id": "ha_token", "key": "ha_token", "name": "ha_token",
      "title": "HA Token", "label": "HA Token",
      "type": "string", "default": ""
    },
    {
      "id": "theme", "key": "theme", "name": "theme",
      "title": "Theme", "label": "Theme",
      "type": "select", "options": ["Auto (System)", "Dark", "Light"], "default": "Auto (System)"
    },
    {
      "id": "menu_position", "key": "menu_position", "name": "menu_position",
      "title": "Position", "label": "Position",
      "type": "select", "options": ["Center", "Left", "Right"], "default": "Right"
    },
    {
      "id": "scale", "key": "scale", "name": "scale",
      "title": "Size", "label": "Size",
      "type": "select", "options": ["80%", "100%", "120%"], "default": "100%"
    },
    {
      "id": "btn1", "key": "btn1", "name": "btn1",
      "title": "Button 1 (Icon | Color | Action)", "label": "Button 1 (Icon | Color | Action)",
      "type": "string", "default": "mdi-home-import-outline | #4CAF50 | script.ligar_casa_diogo"
    },
    {
      "id": "btn2", "key": "btn2", "name": "btn2",
      "title": "Button 2 (Icon | Color | Action)", "label": "Button 2 (Icon | Color | Action)",
      "type": "string", "default": "mdi-home-export-outline | #F44336 | script.desligar_tudo_teste"
    },
    {
      "id": "btn3", "key": "btn3", "name": "btn3",
      "title": "Button 3 (Icon | Color | Action)", "label": "Button 3 (Icon | Color | Action)",
      "type": "string", "default": "mdi-spotify | #1DB954 | script.abrir_spotify_no_tablet"
    },
    {
      "id": "btn4", "key": "btn4", "name": "btn4",
      "title": "Button 4 (Icon | Color | Action)", "label": "Button 4 (Icon | Color | Action)",
      "type": "string", "default": ""
    },
    {
      "id": "btn5", "key": "btn5", "name": "btn5",
      "title": "Button 5 (Icon | Color | Action)", "label": "Button 5 (Icon | Color | Action)",
      "type": "string", "default": ""
    }
  ],
  "commands": [
    {
      "id": "show", "key": "show", "name": "show",
      "title": "Show Bar", "label": "Show Bar"
    },
    {
      "id": "hide", "key": "hide", "name": "hide",
      "title": "Hide Bar", "label": "Hide Bar"
    }
  ]
}
